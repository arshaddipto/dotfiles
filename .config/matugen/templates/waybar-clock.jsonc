// Generated by Matugen - do not edit manually
// Source: ~/.config/matugen/templates/waybar-clock.jsonc
{
    "clock": {
        "format": "{:%I:%M %p}",
        "format-alt": "{:%A, %B %d, %Y (%R)}",
        "tooltip": true,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 4,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='{{ colors.secondary.default.hex }}'><b>{}</b></span>",
                "days": "<span color='{{ colors.on_surface.default.hex }}'><b>{}</b></span>",
                "weeks": "<span color='{{ colors.tertiary.default.hex }}'><b>W{}</b></span>",
                "weekdays": "<span color='{{ colors.secondary.default.hex }}'><b>{}</b></span>",
                "today": "<span color='{{ colors.primary.default.hex }}'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    }
}
